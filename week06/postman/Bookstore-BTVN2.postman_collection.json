    {
      "name": "Offset",
      "item": [
        {
          "name": "01 - Offset trang dau",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?strategy=offset&genre=tech&sort=-price,title&offset=0&limit=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "books"
              ],
              "query": [
                {
                  "key": "strategy",
                  "value": "offset"
                },
                {
                  "key": "genre",
                  "value": "tech"
                },
                {
                  "key": "sort",
                  "value": "-price,title"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Danh sach sach\", function () { pm.expect(body.data).to.be.an(\"array\"); });",
                  "pm.test(\"Dung genre tech\", function () {",
                  "  body.data.forEach(book => pm.expect(book.category.slug).to.eql(\"tech\"));",
                  "});",
                  "pm.test(\"Gia giam, title tang, id giam khi trung\", function () {",
                  "  for (let i = 1; i < body.data.length; i++) {",
                  "    const a = body.data[i - 1], b = body.data[i];",
                  "    const ok = a.price_vnd > b.price_vnd ||",
                  "      (a.price_vnd === b.price_vnd && (a.title < b.title ||",
                  "       (a.title === b.title && a.id > b.id)));",
                  "    pm.expect(ok).to.eql(true);",
                  "  }",
                  "});",
                  "pm.test(\"Metadata offset\", function () {",
                  "  pm.expect(body.pagination.offset).to.eql(0);",
                  "  pm.expect(body.pagination.limit).to.eql(2);",
                  "  pm.expect(body.pagination.total).to.be.at.least(body.data.length);",
                  "  pm.expect(body.pagination.has_next).to.eql(2 < body.pagination.total);",
                  "});",
                  "pm.collectionVariables.set(\"offset_first_ids\", JSON.stringify(body.data.map(b => b.id)));"
                ]
              }
            }
          ]
        },
