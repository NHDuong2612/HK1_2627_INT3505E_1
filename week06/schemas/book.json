{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "isbn",
    "price_vnd",
    "category_id",
    "author_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "isbn": {
      "type": "string",
      "pattern": "^[0-9]{13}$",
      "maxLength": 13
    },
    "price_vnd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "stock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "category_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "author_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    }
  }
}
